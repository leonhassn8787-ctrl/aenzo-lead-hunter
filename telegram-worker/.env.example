# Telegram MTProto credentials — keep private
TELEGRAM_API_ID=replace_with_api_id
TELEGRAM_API_HASH=replace_with_api_hash
TELEGRAM_SESSION_STRING=replace_with_private_string_session

# Supabase backend credentials — secret key is server-side only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
SUPABASE_OWNER_ID=your_supabase_auth_user_uuid

# Persistent paths for optional container hosting
SESSION_FILE=/data/aenzo_telegram.session
STATE_FILE=/data/scan_state.json

# Global public-group search pagination safety limit
GLOBAL_SEARCH_MAX_PAGES=20
LOOKBACK_DAYS=30
LOG_LEVEL=INFO
